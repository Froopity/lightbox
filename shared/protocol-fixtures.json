{
  "$comment": "Golden protocol cases (PLAN.md §4). Each case starts from the boot state, applies `before` (each must reply OK), then sends `line`. `cmd`, when present, must encode to exactly `line`. On expectError the reply is \"ERR <n>\" and the state is unchanged. expectState is partial. fps is 0 in tests.",
  "boot": {
    "style": 0,
    "rate": 500,
    "brightness": 800,
    "global": 1000,
    "colors": [
      "#9966CC",
      "#000000"
    ],
    "params": [
      10,
      0,
      0,
      0,
      0
    ],
    "lfo": {
      "on": 0,
      "target": 0,
      "mHz": 0,
      "depth": 0
    }
  },
  "fixtures": [
    {
      "name": "hello",
      "cmd": {
        "type": "H"
      },
      "line": "H*48",
      "expectReply": "OK lightbox 2"
    },
